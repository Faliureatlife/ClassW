local Fib X Result in
  Fib = proc {$ N Out } in
    local Zero One Two N1 N2 Out1 Out2 A B in
      Zero = 0
      One = 1
      Two = 2
      {Eq N Zero B}
      {Eq N One A}
      if B then
        Out = 1
        skip Stack
      else
        if A then
          Out = 2
          skip Stack
        else
          {IntMinus N One N1}
          {IntMinus N Two N2}
          {Fib N1 Out1}
          {Fib N2 Out2}
          {IntPlus Out1 Out2 Out}
        end
      end
    end
  end
  X = 10
  {Fib X Result}
  skip Browse Result
end
